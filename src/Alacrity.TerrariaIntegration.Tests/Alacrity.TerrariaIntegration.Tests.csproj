<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alacrity.PluginSdk\Alacrity.PluginSdk.csproj" />
    <ProjectReference Include="..\Alacrity.Core\Alacrity.Core.csproj" />
    <ProjectReference Include="..\Alacrity.TerrariaIntegration\Alacrity.RuntimeStaging.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Terraria"><HintPath>$(AlacrityTerrariaAssemblyPath)</HintPath><Private>true</Private></Reference>
    <!-- Test-only copies allow the executable harness to exercise a real GraphicsDevice without
         changing production's external-reference deployment policy. -->
    <Reference Include="Microsoft.Xna.Framework"><HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics"><HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Game"><HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="TerrariaIntegrationScenarioSuite.cs" />
    <Compile Include="Bridge\BridgeScenarioTests.cs" />
    <Compile Include="GameState\GameStateScenarioTests.cs" />
    <Compile Include="Rendering\RenderingScenarioTests.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Rendering\Overlays\TerrariaOverlayCanvas.cs" Link="TerrariaOverlayCanvas.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Rendering\Projection\TerrariaWorldProjection.cs" Link="TerrariaWorldProjection.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Rendering\Projection\TerrariaWorldProjectionMath.cs" Link="TerrariaWorldProjectionMath.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Rendering\Projection\TerrariaWorldProjectionVerifier.cs" Link="TerrariaWorldProjectionVerifier.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Rendering\Hud\TerrariaAvatarRenderBoundary.cs" Link="TerrariaAvatarRenderBoundary.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\GameState\Combat\CombatCollisionCapture.cs" Link="CombatCollisionCapture.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\GameState\Entities\TerrariaEntitySnapshotService.cs" Link="TerrariaEntitySnapshotService.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\GameState\Entities\EntityGenerationTracker.cs" Link="EntityGenerationTracker.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Runtime\ClientPresentationStateTracker.cs" Link="ClientPresentationStateTracker.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Bridge\ClientManifestIntegrity.cs" Link="ClientManifestIntegrity.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\GameState\World\TerrariaWorldSectionBounds.cs" Link="TerrariaWorldSectionBounds.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\GameState\World\TerrariaWorldSectionSnapshotCache.cs" Link="TerrariaWorldSectionSnapshotCache.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\GameState\World\TerrariaWorldSectionService.cs" Link="TerrariaWorldSectionService.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\GameState\Session\TerrariaSessionPresentationService.cs" Link="TerrariaSessionPresentationService.cs" />
    <Compile Include="..\Alacrity.TerrariaIntegration\Rendering\Culling\TerrariaRenderCullingBounds.cs" Link="TerrariaRenderCullingBounds.cs" />
    <Compile Include="Bridge\ClientManifestIntegrityTests.cs" />
    <Compile Include="GameState\WorldSectionSnapshotTests.cs" />
    <Compile Include="GameState\SessionPresentationTests.cs" />
    <Compile Include="Rendering\RenderCullingBoundsTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
