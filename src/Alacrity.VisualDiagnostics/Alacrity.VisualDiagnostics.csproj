<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PluginPackageDirectory Condition="'$(PluginPackageDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\plugins\alacrity.visual-diagnostics</PluginPackageDirectory>
  </PropertyGroup>
  <Target Name="BuildPluginPackage" AfterTargets="Build">
    <MakeDir Directories="$(PluginPackageDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginPackageDirectory)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\plugin.json" DestinationFolder="$(PluginPackageDirectory)" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Alacrity.PluginSdk\Alacrity.PluginSdk.csproj" />
  </ItemGroup>
</Project>
