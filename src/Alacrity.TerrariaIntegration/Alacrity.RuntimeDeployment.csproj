<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AlacrityRuntimeArtifactDirectory Condition="'$(AlacrityRuntimeArtifactDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\runtime</AlacrityRuntimeArtifactDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RuntimeDeploymentMarker.cs" />
  </ItemGroup>

  <!-- Deployment is intentionally separate from staging and requires an explicit client directory. -->
  <Target Name="DeployAlacrityRuntime">
    <Error Condition="'$(AlacrityRuntimeDeployDirectory)' == ''" Text="Set AlacrityRuntimeDeployDirectory to explicitly deploy staged Alacrity runtime assemblies." />
    <Error Condition="!Exists('$(AlacrityRuntimeArtifactDirectory)\runtime-manifest.txt')" Text="Runtime artifacts are missing. Build Alacrity.RuntimeStaging.csproj before deployment." />
    <ItemGroup>
      <_RootRuntimeAssembly Include="$(AlacrityRuntimeArtifactDirectory)\*.dll" />
      <_RootRuntimeMetadata Include="$(AlacrityRuntimeArtifactDirectory)\VERSION" />
      <_BridgeRuntimeAssembly Include="$(AlacrityRuntimeArtifactDirectory)\bin\*.dll" />
      <_PluginRuntimeArtifact Include="$(AlacrityRuntimeArtifactDirectory)\plugins\**\*.*" />
    </ItemGroup>
    <!-- These are client-owned roots. Deployment creates them but never copies a developer's live data. -->
    <MakeDir Directories="$(AlacrityRuntimeDeployDirectory);$(AlacrityRuntimeDeployDirectory)\bin;$(AlacrityRuntimeDeployDirectory)\plugins;$(AlacrityRuntimeDeployDirectory)\data" />
    <Copy SourceFiles="@(_RootRuntimeAssembly)" DestinationFolder="$(AlacrityRuntimeDeployDirectory)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_RootRuntimeMetadata)" DestinationFolder="$(AlacrityRuntimeDeployDirectory)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_BridgeRuntimeAssembly)" DestinationFolder="$(AlacrityRuntimeDeployDirectory)\bin" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_PluginRuntimeArtifact)" DestinationFiles="@(_PluginRuntimeArtifact->'$(AlacrityRuntimeDeployDirectory)\plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(AlacrityRuntimeArtifactDirectory)\runtime-manifest.txt" DestinationFolder="$(AlacrityRuntimeDeployDirectory)" SkipUnchangedFiles="false" />
  </Target>
</Project>
