<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Alacrity.PluginUiRuntime</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Terraria"><HintPath>$(AlacrityTerrariaAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework"><HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics"><HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Game"><HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Input\NativeTextEditState.cs" />
    <Compile Include="Input\PluginUiRuntime.NativeTextInput.cs" />
    <Compile Include="UserInterface\PluginSearchKeyRepeatState.cs" />
    <Compile Include="UserInterface\PluginSearchTextBuffer.cs" />
    <Compile Include="UserInterface\Banners\BannerSearchPresenter.cs" />
    <Compile Include="Bridge\PluginUiRuntime.RuntimeForwarding.cs" />
    <Compile Include="Bridge\PluginUiRuntimeBridgeState.cs" />
    <Compile Include="Bridge\ClientManifestIntegrity.cs" />
    <!-- Shared source keeps the injected façade able to diagnose a missing/stale SDK DLL. -->
    <Compile Include="..\Alacrity.PluginSdk\Compatibility\BridgeCompatibilityDescriptor.cs" Link="Bridge\BridgeCompatibilityDescriptor.cs" />
    <Compile Include="Bridge\BridgeReflectionResolver.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
