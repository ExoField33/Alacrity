<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Alacrity.RuntimeStaging</AssemblyName>
    <!-- Normal builds write only generated artifacts, never the client/repository root. -->
    <AlacrityRuntimeArtifactDirectory Condition="'$(AlacrityRuntimeArtifactDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\runtime</AlacrityRuntimeArtifactDirectory>
    <AlacrityRuntimeBridgeDirectory>$(AlacrityRuntimeArtifactDirectory)\bin</AlacrityRuntimeBridgeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RuntimeStagingMarker.cs" />
    <ProjectReference Include="Alacrity.TerrariaIntegration.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Alacrity.PluginUiRuntime.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="AlacrityBootstrapRuntime.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.PluginSdk\Alacrity.PluginSdk.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.Core\Alacrity.Core.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.App\Alacrity.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.BetterChat\Alacrity.BetterChat.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.PlayerList\Alacrity.PlayerList.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.DustGoreToggle\Alacrity.DustGoreToggle.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.Hitboxes\Alacrity.Hitboxes.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Alacrity.VisualDiagnostics\Alacrity.VisualDiagnostics.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Query project target outputs instead of reconstructing target-framework output paths. -->
  <Target Name="StageAlacrityRuntime" AfterTargets="Build">
    <MSBuild Projects="Alacrity.TerrariaIntegration.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_BridgeOutput" />
    </MSBuild>
    <MSBuild Projects="Alacrity.PluginUiRuntime.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_FacadeOutput" />
    </MSBuild>
    <MSBuild Projects="AlacrityBootstrapRuntime.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_BootstrapOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.PluginSdk\Alacrity.PluginSdk.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_SdkOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.Core\Alacrity.Core.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_CoreOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.App\Alacrity.App.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_AppOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.BetterChat\Alacrity.BetterChat.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_BetterChatOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.PlayerList\Alacrity.PlayerList.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_PlayerListOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.DustGoreToggle\Alacrity.DustGoreToggle.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_DustGoreOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.Hitboxes\Alacrity.Hitboxes.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_HitboxesOutput" />
    </MSBuild>
    <MSBuild Projects="..\Alacrity.VisualDiagnostics\Alacrity.VisualDiagnostics.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_VisualDiagnosticsOutput" />
    </MSBuild>

    <ItemGroup>
      <_RuntimeAssembly Include="$(_BridgeOutput);$(_FacadeOutput);$(_BootstrapOutput);$(_SdkOutput);$(_CoreOutput);$(_AppOutput)" />
      <!-- The patcher imports the facade from bin; the CLR resolves the same facade beside Alacrity.exe. -->
      <_BridgeAssembly Include="$(_BridgeOutput);$(_FacadeOutput);$(_BootstrapOutput);$(_SdkOutput);$(_CoreOutput);$(_AppOutput)" />
      <_RuntimeMetadata Include="$(MSBuildThisFileDirectory)..\..\VERSION" />
      <_PluginPackage Include="$(_BetterChatOutput)">
        <PluginId>alacrity.better-chat</PluginId>
      </_PluginPackage>
      <_PluginPackage Include="$(_PlayerListOutput)">
        <PluginId>alacrity.player-list</PluginId>
      </_PluginPackage>
      <_PluginPackage Include="$(_DustGoreOutput)">
        <PluginId>alacrity.dust-gore-toggle</PluginId>
      </_PluginPackage>
      <_PluginPackage Include="$(_HitboxesOutput)">
        <PluginId>alacrity.hitboxes</PluginId>
      </_PluginPackage>
      <_PluginPackage Include="$(_VisualDiagnosticsOutput)">
        <PluginId>alacrity.visual-diagnostics</PluginId>
      </_PluginPackage>
      <_PluginManifest Include="..\Alacrity.BetterChat\plugin.json">
        <PluginId>alacrity.better-chat</PluginId>
      </_PluginManifest>
      <_PluginManifest Include="..\Alacrity.PlayerList\plugin.json">
        <PluginId>alacrity.player-list</PluginId>
      </_PluginManifest>
      <_PluginManifest Include="..\Alacrity.DustGoreToggle\plugin.json">
        <PluginId>alacrity.dust-gore-toggle</PluginId>
      </_PluginManifest>
      <_PluginManifest Include="..\Alacrity.Hitboxes\plugin.json">
        <PluginId>alacrity.hitboxes</PluginId>
      </_PluginManifest>
      <_PluginManifest Include="..\Alacrity.VisualDiagnostics\plugin.json">
        <PluginId>alacrity.visual-diagnostics</PluginId>
      </_PluginManifest>
      <_RuntimeFile Include="@(_RuntimeAssembly)">
        <RelativePath>%(_RuntimeAssembly.Filename)%(_RuntimeAssembly.Extension)</RelativePath>
      </_RuntimeFile>
      <_RuntimeFile Include="@(_BridgeAssembly)">
        <RelativePath>bin\%(_BridgeAssembly.Filename)%(_BridgeAssembly.Extension)</RelativePath>
      </_RuntimeFile>
      <_RuntimeFile Include="@(_PluginPackage)">
        <RelativePath>plugins\%(_PluginPackage.PluginId)\%(_PluginPackage.Filename)%(_PluginPackage.Extension)</RelativePath>
      </_RuntimeFile>
      <_RuntimeFile Include="@(_PluginManifest)">
        <RelativePath>plugins\%(_PluginManifest.PluginId)\plugin.json</RelativePath>
      </_RuntimeFile>
      <_RuntimeFile Include="@(_RuntimeMetadata)">
        <RelativePath>VERSION</RelativePath>
      </_RuntimeFile>
    </ItemGroup>
    <Error Condition="'@(_RuntimeAssembly)' == '' Or !Exists('$(_BridgeOutput)') Or !Exists('$(_FacadeOutput)') Or !Exists('$(_BootstrapOutput)') Or !Exists('$(_SdkOutput)') Or !Exists('$(_CoreOutput)') Or !Exists('$(_AppOutput)') Or !Exists('$(MSBuildThisFileDirectory)..\..\VERSION')" Text="Alacrity runtime staging requires every managed assembly and the current VERSION file from this build." />

    <!-- A fresh stage cannot silently retain an older runtime component. -->
    <RemoveDir Directories="$(AlacrityRuntimeArtifactDirectory)" />
    <MakeDir Directories="$(AlacrityRuntimeArtifactDirectory);$(AlacrityRuntimeBridgeDirectory)" />
    <Copy SourceFiles="@(_RuntimeAssembly)" DestinationFolder="$(AlacrityRuntimeArtifactDirectory)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_BridgeAssembly)" DestinationFolder="$(AlacrityRuntimeBridgeDirectory)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_RuntimeMetadata)" DestinationFolder="$(AlacrityRuntimeArtifactDirectory)" SkipUnchangedFiles="false" />
    <MakeDir Directories="@(_PluginPackage->'$(AlacrityRuntimeArtifactDirectory)\plugins\%(PluginId)')" />
    <Copy SourceFiles="@(_PluginPackage)" DestinationFiles="@(_PluginPackage->'$(AlacrityRuntimeArtifactDirectory)\plugins\%(PluginId)\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_PluginManifest)" DestinationFiles="@(_PluginManifest->'$(AlacrityRuntimeArtifactDirectory)\plugins\%(PluginId)\plugin.json')" SkipUnchangedFiles="false" />
    <GetFileHash Files="@(_RuntimeFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_RuntimeHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(AlacrityRuntimeArtifactDirectory)\runtime-manifest.txt" Lines="Configuration=$(Configuration);@(_RuntimeHash->'%(RelativePath)|%(FileHash)')" Overwrite="true" />
  </Target>
</Project>
