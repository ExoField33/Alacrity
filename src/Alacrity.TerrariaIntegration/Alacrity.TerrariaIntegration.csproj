<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- The injected bridge predates nullable annotations and is intentionally
         compiled as a compatibility boundary against Terraria's legacy API. -->
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Alacrity.PluginUiCoreBridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alacrity.App\Alacrity.App.csproj" />
    <ProjectReference Include="..\Alacrity.Core\Alacrity.Core.csproj" />
    <ProjectReference Include="..\Alacrity.PluginSdk\Alacrity.PluginSdk.csproj" />
    <Reference Include="Terraria">
      <HintPath>$(AlacrityTerrariaAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="Bridge\PluginUiRuntime.CoreBridge.cs" />
    <Compile Include="Runtime\PluginUiRuntime.Composition.cs" />
    <Compile Include="Runtime\PluginUiRuntime.FacadeState.cs" />
    <Compile Include="Runtime\PluginUiRuntimeState.cs" />
    <Compile Include="Runtime\PluginUiRuntimeHost.cs" />
    <Compile Include="Runtime\PluginUiRuntimeBridgeState.cs" />
    <Compile Include="Runtime\PluginUiRuntime.Lifecycle.cs" />
    <Compile Include="Chat\PluginUiRuntime.Chat.cs" />
    <Compile Include="Chat\PluginUiRuntime.Commands.cs" />
    <Compile Include="Chat\BetterChatRuntime.cs" />
    <Compile Include="Input\PluginUiRuntime.InputBridge.cs" />
    <Compile Include="GameState\Combat\CombatCollisionCapture.cs" />
    <Compile Include="GameState\Entities\TerrariaEntitySnapshotService.cs" />
    <Compile Include="GameState\Entities\EntityGenerationTracker.cs" />
    <Compile Include="GameState\World\TerrariaWorldSectionService.cs" />
    <Compile Include="GameState\World\TerrariaWorldSectionSnapshotCache.cs" />
    <Compile Include="GameState\World\TerrariaWorldSectionBounds.cs" />
    <Compile Include="Rendering\Overlays\TerrariaOverlayAdapter.cs" />
    <Compile Include="Input\PluginUserInteractionBackend.cs" />
    <Compile Include="Rendering\Hud\TerrariaHudAdapter.cs" />
    <Compile Include="Rendering\Hud\TerrariaAvatarRenderBoundary.cs" />
    <Compile Include="GameState\Session\TerrariaSessionPresentationService.cs" />
    <Compile Include="Rendering\Overlays\TerrariaOverlayCanvas.cs" />
    <Compile Include="Rendering\Projection\TerrariaWorldProjection.cs" />
    <Compile Include="Rendering\Projection\TerrariaWorldProjectionMath.cs" />
    <Compile Include="Rendering\Projection\TerrariaWorldProjectionVerifier.cs" />
    <Compile Include="Runtime\TerrariaPluginRuntimeFactory.cs" />
    <Compile Include="Runtime\ClientPresentationStateTracker.cs" />
    <Compile Include="Rendering\TerrariaPluginDrawAdapter.cs" />
    <Compile Include="Rendering\PluginUiRuntime.RenderingBridge.cs" />
    <Compile Include="Rendering\PluginUiRuntime.PaintPreparationBridge.cs" />
    <Compile Include="Rendering\PluginUiRuntime.PresentationSuppressionBridge.cs" />
    <Compile Include="Rendering\LaserRuler\TerrariaLaserRulerPresentation.cs" />
    <Compile Include="Rendering\Rain\TerrariaInstancedRainPresentation.cs" />
    <Compile Include="Rendering\Optimization\TerrariaLightingParallelExecutor.cs" />
    <Compile Include="Rendering\Optimization\PluginUiRuntime.LightingBridge.cs" />
    <Compile Include="Rendering\TileChunks\StaticTileChunkEligibility.Generated.cs" />
    <Compile Include="Rendering\TileChunks\TerrariaStaticTileChunkRenderer.cs" />
    <Compile Include="Rendering\Culling\TerrariaRenderCullingAdapter.cs" />
    <Compile Include="Rendering\Culling\TerrariaRenderCullingBounds.cs" />
    <Compile Include="Rendering\Culling\PluginUiRuntime.RenderCullingBridge.cs" />
    <Compile Include="Chat\TerrariaPluginChatAdapter.cs" />
    <Compile Include="Chat\TerrariaChatActionStrip.cs" />
    <Compile Include="Runtime\TerrariaPluginOperationCoordinator.cs" />
    <Compile Include="Persistence\TerrariaPluginEnabledStateStore.cs" />
    <Compile Include="VisualEffects\TerrariaVisualEffectsRuntimePolicy.cs" />
    <Compile Include="VisualEffects\TerrariaVisualEffectsAdapter.cs" />
    <Compile Include="VisualEffects\PluginUiRuntime.VisualEffectsBridge.cs" />
    <Compile Include="Input\TerrariaPluginKeybindPersistence.cs" />
    <Compile Include="Input\TerrariaPluginKeybindControlsAdapter.cs" />
    <Compile Include="Input\TerrariaKeybindRuntime.cs" />
    <Compile Include="UserInterface\PluginDropdownFilter.cs" />
    <Compile Include="UserInterface\PluginSearchKeyRepeatState.cs" />
    <Compile Include="UserInterface\PluginSearchTextElement.cs" />
    <Compile Include="UserInterface\PluginSearchTextBuffer.cs" />
    <Compile Include="UserInterface\PluginManager\PluginUiRuntime.DescriptionMenu.cs" />
    <Compile Include="UserInterface\PluginManager\PluginUiRuntime.SelectionMenu.cs" />
    <Compile Include="UserInterface\PluginManager\PluginUiRuntime.PluginMenuBridge.cs" />
    <Compile Include="UserInterface\Settings\PluginUiRuntime.SettingsMenu.cs" />
    <Compile Include="UserInterface\Settings\PluginUiRuntime.IngamePluginList.cs" />
    <Compile Include="UserInterface\Settings\PluginUiRuntime.IngamePluginSettings.cs" />
  </ItemGroup>

  <PropertyGroup>
    <RainEffectSource>$(MSBuildProjectDirectory)\Rendering\Rain\InstancedRainPresentation.fx</RainEffectSource>
    <RainEffectIntermediateDirectory>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)</RainEffectIntermediateDirectory>
    <RainEffectOutput>$(RainEffectIntermediateDirectory)\InstancedRainPresentation.mgfxo</RainEffectOutput>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(RainEffectOutput)" LogicalName="AlacrityTerraria.Rendering.Rain.InstancedRainPresentation.mgfxo" />
  </ItemGroup>

  <Target Name="CompileInstancedRainEffect" BeforeTargets="CoreCompile" Inputs="$(RainEffectSource)" Outputs="$(RainEffectOutput)">
    <MakeDir Directories="$(RainEffectIntermediateDirectory)" />
    <Exec Command="dotnet tool run mgfxc &quot;$(RainEffectSource)&quot; &quot;$(RainEffectOutput)&quot; /Profile:OpenGL" />
  </Target>
</Project>
