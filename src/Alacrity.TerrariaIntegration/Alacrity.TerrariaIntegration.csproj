<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- The injected bridge predates nullable annotations and is intentionally
         compiled as a compatibility boundary against Terraria's legacy API. -->
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alacrity.App\Alacrity.App.csproj" />
    <ProjectReference Include="..\Alacrity.Core\Alacrity.Core.csproj" />
    <ProjectReference Include="..\Alacrity.PluginSdk\Alacrity.PluginSdk.csproj" />
    <Reference Include="Terraria">
      <HintPath>$(AlacrityTerrariaAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ReLogic">
      <HintPath>$(AlacrityReLogicAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>$(AlacrityXnaReferenceDirectory)\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AlacrityPluginUiCoreBridge.cs" />
    <Compile Include="BetterChatRuntime.cs" />
    <Compile Include="CombatCollisionCapture.cs" />
    <Compile Include="TerrariaEntitySnapshotService.cs" />
    <Compile Include="TerrariaOverlayAdapter.cs" />
    <Compile Include="PluginUserInteractionBackend.cs" />
    <Compile Include="TerrariaHudAdapter.cs" />
    <Compile Include="TerrariaSessionPresentationService.cs" />
    <Compile Include="TerrariaOverlayCanvas.cs" />
    <Compile Include="TerrariaWorldProjection.cs" />
    <Compile Include="TerrariaWorldProjectionMath.cs" />
    <Compile Include="TerrariaPluginRuntimeFactory.cs" />
    <Compile Include="TerrariaPluginDrawAdapter.cs" />
    <Compile Include="TerrariaPluginChatAdapter.cs" />
    <Compile Include="TerrariaPluginOperationCoordinator.cs" />
    <Compile Include="TerrariaPluginEnabledStateStore.cs" />
    <Compile Include="TerrariaVisualEffectsRuntimePolicy.cs" />
    <Compile Include="TerrariaPluginKeybindPersistence.cs" />
    <Compile Include="TerrariaPluginKeybindControlsAdapter.cs" />
    <Compile Include="TerrariaPluginDescriptionMenu.cs" />
    <Compile Include="TerrariaPluginSelectionMenu.cs" />
    <Compile Include="TerrariaPluginSettingsMenu.cs" />
    <Compile Include="TileStorage.cs" />
    <Compile Include="TileDataCompatibility.cs" />
  </ItemGroup>
</Project>
